<?xml version="1.0"?>
<package format="3">
  <name>gesture_recognition</name>
  <version>0.0.1</version>
  <description>The gesture_recognition package for ROS 2</description>
  <maintainer email='luisafrancielle@todo.todo'>luisa</maintainer>
  <license>Apache-2.0</license>

  <author email='luisafrancielle@todo.todo'>luisa</author>

  <!-- ROS 2 utiliza ament como sistema de construção, então catkin não é mais necessário -->
  <buildtool_depend>ament_python</buildtool_depend>

  <depend>cv_bridge</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <!-- Informação adicional para outras ferramentas -->
    <build_type>ament_python</build_type>
  </export>
</package>